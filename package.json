{
  "name": "sys2qa-monorepo",
  "private": true,
  "type": "module",
  "description": "Sys2QA — evidence-based system analysis (SAA) and quality assurance (QAA) platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "schemas:types": "node packages/contract/scripts/generate-types.mjs",
    "schemas:check": "node packages/contract/scripts/generate-types.mjs --check",
    "fixtures": "node packages/contract/scripts/fixtures.mjs",
    "fixtures:check": "node packages/contract/scripts/fixtures.mjs --check",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "trace": "vitest run --reporter=default --reporter=json --outputFile.json=reports/test-results.json && node scripts/traceability.mjs --results reports/test-results.json",
    "trace:check": "node scripts/traceability.mjs",
    "bench": "node --conditions=source --import tsx tests/benchmark/run.ts",
    "sys2qa": "node --conditions=source --import tsx apps/cli/src/bin.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm schemas:check && pnpm fixtures:check && pnpm deps:check && pnpm trace:check && pnpm docs:links && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
