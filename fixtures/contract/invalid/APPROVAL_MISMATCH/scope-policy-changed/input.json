{
  "scenario": {
    "schema_version": "1.0.0",
    "scenario_id": "scenario:registration.nib.invalid_length_12",
    "display_key": "TC-REG-002",
    "version": 1,
    "content_language": "en",
    "title": { "language": "en", "value": "Reject registration when NIB has 12 digits" },
    "feature_ref": "module:web.registration",
    "test_condition_ids": ["tcond:registration.nib.length_boundary"],
    "category": "negative_validation",
    "qa_objective": "implementation_conformance",
    "test_techniques": [
      { "id": "boundary_value_analysis", "rationale": "NIB length is fixed at 13; 12 is just below the boundary." }
    ],
    "priority": "high",
    "risk": {
      "impact": 4,
      "likelihood": 3,
      "exposure": ["primary_workflow"],
      "score": 12,
      "rationale": "Invalid identifiers would create unusable registrations."
    },
    "execution_modes": ["manual", "automated"],
    "execution_classification": "both",
    "state_changing": false,
    "preconditions": [
      {
        "id": "pre-1",
        "text": { "language": "en", "value": "Signed in with credential profile 'applicant'." },
        "credential_profile_ref": "secretref:applicant"
      },
      { "id": "pre-2", "text": { "language": "en", "value": "Registration page is reachable." } }
    ],
    "test_data": [{ "name": "nib", "value_ref": "fixture:registration.nib_12_digits", "sensitivity": "non_secret" }],
    "steps": [
      {
        "step_id": "S1",
        "instruction": { "language": "en", "value": "Open the registration page." },
        "automation": { "action": "navigate", "target": { "kind": "route", "value": "/registrasi" } },
        "expected_result": null
      },
      {
        "step_id": "S2",
        "instruction": { "language": "en", "value": "Enter a 12-digit NIB." },
        "automation": {
          "action": "fill",
          "target": {
            "kind": "label",
            "value": "NIB",
            "literal_language": "id",
            "source_ref": "field:web:/registrasi#registration.nib"
          },
          "value_ref": "fixture:registration.nib_12_digits"
        },
        "expected_result": null
      },
      {
        "step_id": "S3",
        "instruction": { "language": "en", "value": "Submit the form." },
        "automation": {
          "action": "click",
          "target": { "kind": "role", "role": "button", "name": "Daftar", "literal_language": "id" }
        },
        "expected_result": {
          "description": { "language": "en", "value": "A NIB format error is shown and no registration is created." },
          "assertions": [
            { "type": "visible", "target": { "kind": "test_id", "value": "error-nib" } },
            { "type": "url", "operator": "equals", "value": "/registrasi" }
          ],
          "basis": "saa_documented",
          "saa_status": "source_verified",
          "oracle_class": "implemented",
