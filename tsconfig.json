{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/*/src",
    "apps/*/test",
    "packages/*/src",
    "packages/*/test",
    "tests",
    "scripts/*.d.mts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": ["apps/web/src", "tests/e2e"]
}
